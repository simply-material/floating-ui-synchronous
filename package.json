{
  "name": "floating-ui-synchronous",
  "version": "1.0.0",
  "description": "Reproducible synchronous distributions of Floating UI core and DOM",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepare:inputs": "node src/cli.ts prepare",
    "build": "node src/cli.ts build",
    "test": "vitest run",
    "test:packages": "vitest run tests/packages.test.ts",
    "test:types": "vitest run tests/types.test.ts",
    "test:browser": "playwright test",
    "check": "npm run format:check && npm run typecheck && npm run build && npm test && npm run test:browser"
  },
  "devDependencies": {
    "@floating-ui/core": "1.8.0",
    "@floating-ui/dom": "1.8.0",
    "@floating-ui/utils": "0.2.12",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "rollup": "4.64.9",
    "tar": "7.5.22",
    "terser": "5.51.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "private": true
}
